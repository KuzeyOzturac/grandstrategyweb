{
  "name": "world-atlas",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive world map of countries and administrative regions",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "vite build",
