    "verify": "npm run check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "d3-geo": "^3.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
